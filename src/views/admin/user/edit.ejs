<section>
  <div>
    <h1>Editar Usuário</h1>

    <p>
      Edite as informações do usuário.
    </p>
  </div>

  <a href="/admin/users">
    Voltar para usuários
  </a>
</section>

<section class="ticket-form">
  <h2>Dados do usuário</h2>

  <form
    action="/admin/users/<%= user.id %>/edit"
    method="POST"
  >
    <div class="form-group">
      <label for="name">Nome</label>

      <input
        type="text"
        id="name"
        name="name"
        value="<%= user.name %>"
        minlength="3"
        maxlength="100"
        required
      >

      <% if (errors.name) { %>
        <span class="field-error">
          <%= errors.name %>
        </span>
      <% } %>
    </div>

    <div class="form-group">
      <label for="email">E-mail</label>

      <input
        type="email"
        id="email"
        name="email"
        value="<%= user.email %>"
        maxlength="254"
        required
      >

      <% if (errors.email) { %>
        <span class="field-error">
          <%= errors.email %>
        </span>
      <% } %>
    </div>

    <button type="submit">
      Salvar alterações
    </button>
  </form>
</section>

<section class="ticket-form">
  <h2>Perfil de acesso</h2>

  <p>
    Perfil atual:
    <strong>
      <%= user.role === "ADMIN"
        ? "Administrador"
        : "Usuário comum"
      %>
    </strong>
  </p>

  <form
    action="/admin/users/<%= user.id %>/role"
    method="POST"
  >
    <% if (user.role === "ADMIN") { %>
      <input
        type="hidden"
        name="role"
        value="USER"
      >

      <button type="submit">
        Tornar usuário comum
      </button>
    <% } else { %>
      <input
        type="hidden"
        name="role"
        value="ADMIN"
      >

      <button type="submit">
        Tornar administrador
      </button>
    <% } %>
  </form>

  <% if (errors.role) { %>
    <span class="field-error">
      <%= errors.role %>
    </span>
  <% } %>
</section>

<section class="ticket-form">
  <h2>Status da conta</h2>

  <p>
    Status atual:
    <strong>
      <%= user.active ? "Ativo" : "Inativo" %>
    </strong>
  </p>

  <form
  action="/admin/users/<%= user.id %>/status"
  method="POST"
>
  <input
    type="hidden"
    name="active"
    value="<%= user.active ? "false" : "true" %>"
  >

  <button type="submit">
    <%= user.active
      ? "Desativar usuário"
      : "Ativar usuário"
    %>
  </button>
</form>

  <% if (errors.active) { %>
    <span class="field-error">
      <%= errors.active %>
    </span>
  <% } %>
</section>